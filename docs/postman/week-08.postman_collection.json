{
  "info": {
    "name": "spring-ai-alibaba-agent（第8周 Spring AI Alibaba Graph Agent）",
    "description": "运行 Spring AI Alibaba Graph 编排的 Agent（agent ↔ tools 循环，模型经 Spring AI OpenAI 兼容通道指向 DeepSeek）。启动：apps/spring-ai-alibaba-agent 下 .\\run-maven-jdk17.ps1 spring-boot:run（需配置环境变量 LLM_API_KEY，否则返回 502）。端口 8084。可用工具：PatientLookupTool、HealthMetricTool。MCP 工具暴露见 GET /sse。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8084" },
    { "key": "task", "value": "分析患者 P001 的健康指标，给出随访建议" }
  ],
  "item": [
    {
      "name": "1. 运行 Graph Agent（查询患者指标）",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('code 为 SUCCESS', function () {",
              "    pm.expect(body.code).to.eql('SUCCESS');",
              "});",
              "pm.test('返回非空答案', function () {",
              "    pm.expect(body.data.answer).to.be.a('string').and.not.empty;",
              "});",
              "console.log('answer =', body.data.answer);",
              "console.log('steps =', body.data.totalSteps, 'usage =', JSON.stringify(body.data.usage));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"task\": \"分析患者 P001 的健康指标，给出随访建议\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/framework/agents/runs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "framework", "agents", "runs"]
        }
      }
    },
    {
      "name": "2. 运行 Graph Agent（查询患者基础信息）",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"task\": \"查询患者 P001 的基本信息\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/framework/agents/runs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "framework", "agents", "runs"]
        }
      }
    },
    {
      "name": "3. 空白任务 → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 + VALIDATION_ERROR', function () {",
              "    pm.response.to.have.status(400);",
              "    pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"task\": \"   \"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/framework/agents/runs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "framework", "agents", "runs"]
        }
      }
    },
    {
      "name": "4. 任务超长（8001 字符）→ 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 + VALIDATION_ERROR', function () {",
              "    pm.response.to.have.status(400);",
              "    pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"task\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/framework/agents/runs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "framework", "agents", "runs"]
        }
      }
    },
    {
      "name": "5. MCP SSE 握手（GET /sse）",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sse",
          "host": ["{{baseUrl}}"],
          "path": ["sse"]
        }
      }
    }
  ]
}
