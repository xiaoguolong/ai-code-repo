# spring-ai-alibaba-agent 环境变量模板（第 8 周 Spring AI Alibaba Graph Agent，第 16 周起接入 PostgreSQL）
# 复制为 .env（同目录）后按需填写；真实 Key 与连接串切勿提交到仓库（.env 已被 .gitignore 忽略）。
#
# 怎么被读取（二选一，环境变量优先级高于 .env）：
#   IDEA  ：运行配置用 EnvFile 插件指向本文件复制出的 .env（$PROJECT_DIR$/apps/spring-ai-alibaba-agent/.env）
#   命令行：在模块目录下启动时由 spring.config.import 自动读取本目录 .env
#
# 数据库名/主机/账号各环境都不同，这里只给格式，填你们环境自己的值即可；
# 代码与文档不含任何具体库名，配什么就连什么。

# —— 模型（必填）——
# Spring AI 的 OpenAI 兼容端点：只写主机名，切勿带 /v1（Spring AI 自行拼接 /v1/chat/completions）。
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# —— ai-core 统一 LLM 参数（本模块 Graph 运行时常量；base-url 含 /v1）——
LLM_BASE_URL=https://api.deepseek.com/v1

# —— 可选：本机代理（仅 openai-compatible 适配器走 ai-core RestClient 时生效）——
LLM_PROXY_HOST=
LLM_PROXY_PORT=7890

# —— 可选：框架适配器 spring-ai（默认）| openai-compatible ——
FRAMEWORK_MODEL_PROVIDER=spring-ai

# —— 可选：Prompt 模板版本 ——
PROMPT_VERSION=v1

# —— 数据库（落库模式必填；各环境填自己的库）——
# 第 16 周起平台 RBAC / 执行记录 / 审计落 PostgreSQL，Flyway 在启动时自动迁移。
# 该库可以与其它应用共用：本模块使用专属历史表 flyway_schema_history_platform 隔离版本号。
# 注意：URL 里的库名与账号请替换为本环境实际值，不要照抄示例中的占位符。
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:<db-port>/<db-name>
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>
# Spring Boot 会自动把上面的 SPRING_DATASOURCE_* 绑定到 spring.datasource.*，无需额外变量。

# —— 可选：持久化模式（默认 jdbc 落库；memory = 进程内，无需数据库，用于快速演示）——
# PLATFORM_PERSISTENCE_MODE=jdbc

# —— 可选：密码哈希盐（生产必须覆盖，禁止用默认值）——
AUTH_PASSWORD_SALT=change-me-please

# ── Week 22：登录 / 身份校验限流（默认开启：5 次失败 / 5 分钟窗口 / 封 5 分钟）──
# 本地联调想关掉就设 false；生产不要关。
PLATFORM_RATE_LIMIT_ENABLED=true
PLATFORM_RATE_LIMIT_MAX_ATTEMPTS=5
PLATFORM_RATE_LIMIT_WINDOW_SECONDS=300
PLATFORM_RATE_LIMIT_BLOCK_SECONDS=300
# 只有当 8084 前面确实有可信反代（nginx 会覆盖 X-Forwarded-For）时才置 true；
# 直接暴露在公网时保持 false，否则可被伪造头绕过。
PLATFORM_RATE_LIMIT_TRUST_FORWARDED_FOR=false

# —— 可选：Sa-Token 会话时长（秒）——
# SA_TOKEN_TIMEOUT=86400

# —— 可选：Redis（第 17 周可观测与后续缓存使用；本模块当前不依赖）——
REDIS_HOST=localhost
REDIS_PORT=6379
# ── 可选：Week 18 Langfuse（LLM Trace / Prompt 管理 / Token 与成本）──
# 默认全关（LANGFUSE_ENABLED 不设或 false 时零导出、零 langfuse.* 属性、Prompt 走 classpath）。
# host 是 Langfuse Web 根地址（端口 3000），OTLP 摄取端点由应用拼成 <host>/api/public/otel/v1/traces。
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://<langfuse-host>:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 仅用于拼 UI 深链（langfuse-status / trace-context 的 langfuseTraceUrl），不填则该字段为 null
LANGFUSE_PROJECT_ID=
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=
# 正文采集：默认关闭；置 true 时必须同时保证 guardrail.enabled=true（否则采集自动失效）
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_MAX_CONTENT_CHARS=2000
LANGFUSE_TIMEOUT_MS=10000
# Prompt 管理：与 LANGFUSE_ENABLED 相互独立，只需 host + 密钥
LANGFUSE_PROMPT_ENABLED=false
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60
# 模型价目表（USD / 百万 token）建议写在 application.yml 的 langfuse.model-prices 下（键含横线，环境变量不便表达）
# ── 可选：Week 17 通用 OTLP collector 导出（默认 true，导出到 http://localhost:4318/v1/traces）──
# 本地没起 collector 时置 false，可消除 SDK 的导出失败日志（只影响通用链路后端，不影响 Langfuse）。
OTEL_EXPORT_ENABLED=true
# 需要导出到真实 collector（Jaeger/Tempo/OTel Collector）时改端点；
# 生产按根地址写法：OTEL_EXPORTER_OTLP_ENDPOINT=http://<collector-host>:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ── Week 19：SkyWalking（Java Agent 自动埋点 + Toolkit 手动埋点）────────────────
# 说明：Java Agent 的开关**不在本文件**，而在启动参数 `-javaagent:<skywalking-agent.jar>`；
#       下面三项既供 Agent 读取（SW_AGENT_*），也供 /observability/skywalking-status 自检展示。
# 注意：只设置这些变量而不挂 Agent 时，自检会如实回 bridgeAvailable=false（这是设计行为）。
#
# Agent 路径（仅 run-maven-jdk17.ps1 / 启动脚本使用；不是 Spring 配置）
# SKYWALKING_AGENT_PATH=/path/to/skywalking-agent/skywalking-agent.jar
# 服务名（拓扑按它分组）
SW_AGENT_NAME=
# 实例名（同服务多实例区分）
SW_AGENT_INSTANCE_NAME=
# OAP 上报地址（gRPC，注意是 11800 不是 12800）
# SW_AGENT_COLLECTOR_BACKEND_SERVICES=<oap-host>:11800
# 应用侧手动埋点（agent.run / llm.chat / tool.call）开关，默认 false
SKYWALKING_ENABLED=false
# ── Week 20：完整监控体系（仅影响 /observability/monitoring-overview 自检与深链）──────
# 地址默认值已写在 application.yml（本机回环）。云端 Prometheus/Grafana 通过
# tools\tunnel.ps1 的本地 19090/3001 转发访问；不要把公网地址填进来。
# 总开关：false 时 Prometheus/Grafana/网关指标三项一律 DISABLED 且不发起探测
MONITORING_ENABLED=true
# 单次探测超时（毫秒）与结果缓存（秒）
MONITORING_PROBE_TIMEOUT_MS=800
MONITORING_PROBE_CACHE_TTL_SECONDS=30
# Prometheus（注意端口是 19090：云端 9090/9091 被 Langfuse MinIO 占用）
PROMETHEUS_BASE_URL=http://127.0.0.1:19090
# Grafana（默认仪表盘 UID 必须与 deploy/monitoring/grafana/dashboards 一致）
GRAFANA_BASE_URL=http://127.0.0.1:3001
GRAFANA_DASHBOARD_UID=aicode-platform-overview
# SkyWalking UI（深链）
SKYWALKING_UI_URL=http://127.0.0.1:8088
# 网关指标端点（Prometheus 的第二个抓取目标）
GATEWAY_METRICS_URL=http://127.0.0.1:8080/actuator/prometheus
# 指标公共标签：两个应用进同一个 Prometheus 后用于区分曲线（一般不用改）
APP_METRICS_TAG=ai-code-platform
# 采样率（Week 17 已有变量，Week 20 在概览里展示）
# OTEL_TRACES_SAMPLER_PROBABILITY=1.0

# ── Week 21：长期记忆（platform_memory，按 租户+用户 隔离）──────────────────
# 全部可选，默认值见 application.yml：
#   候选集上限 500 / 最低余弦 0.05 / 默认返回 5 条 / 单次硬上限 20 条
# PLATFORM_MEMORY_CANDIDATE_LIMIT=500
# PLATFORM_MEMORY_MIN_SCORE=0.05
# PLATFORM_MEMORY_DEFAULT_TOP_K=5
# PLATFORM_MEMORY_MAX_TOP_K=20

# ── Week 23：长期记忆生命周期（TTL / 清理 / 向量重建）──────────────────────────
# TTL 天数：<=0 表示永不过期；默认 90 天。过期记录读取时不可见，并由每日任务删除。
# PLATFORM_MEMORY_TTL_DAYS=90
# 每日清理开关与 Cron（Spring 6 段：秒 分 时 日 月 周）；单测/本地演示可置 false。
# PLATFORM_MEMORY_CLEANUP_ENABLED=true
# PLATFORM_MEMORY_CLEANUP_CRON=0 30 3 * * *
# 向量重建单批上限（默认 100，最大 500）；换 embedding 模型后由管理员手工触发。
# PLATFORM_MEMORY_REBUILD_BATCH_LIMIT=100

# ── Week 24：Agent 2 运营分析（窗口统计 + 规则异常）────────────────────────────
# 单次统计最多读取的执行记录数；超出后日报里 truncated=true。
# PLATFORM_OPERATIONS_MAX_RECORDS=5000
# 默认 / 最大统计窗口（天）
# PLATFORM_OPERATIONS_DEFAULT_WINDOW_DAYS=7
# PLATFORM_OPERATIONS_MAX_WINDOW_DAYS=30
# 异常阈值：失败率（分母只含成功+失败）、待审积压条数、token 突增倍数、单 Agent 失败下限
# PLATFORM_OPERATIONS_FAILURE_RATE_HIGH=0.30
# PLATFORM_OPERATIONS_FAILURE_RATE_MEDIUM=0.20
# PLATFORM_OPERATIONS_APPROVAL_BACKLOG=20
# PLATFORM_OPERATIONS_TOKEN_SPIKE_RATIO=2.0
# PLATFORM_OPERATIONS_AGENT_FAILURE_MIN=3

# ── Week 24：Agent 4 随访（站内提醒只做查询视图，不接短信/邮件）──────────────
# PLATFORM_FOLLOWUP_DEFAULT_REMINDER_DAYS=7
# PLATFORM_FOLLOWUP_MAX_REMINDER_DAYS=30
# PLATFORM_FOLLOWUP_DEFAULT_LIST_LIMIT=20
# PLATFORM_FOLLOWUP_MAX_LIST_LIMIT=100

# ── Week 24：审批运维（待办积压指标 + 审批/执行一致性对账）────────────────────
# 待办积压 Gauge：每 60s 采样一次，Prometheus 暴露 approval_pending_count。
# PLATFORM_APPROVAL_PENDING_GAUGE_ENABLED=true
# PLATFORM_APPROVAL_PENDING_GAUGE_INTERVAL_MS=60000
# PLATFORM_APPROVAL_PENDING_GAUGE_INITIAL_DELAY_MS=20000
# 对账：按审批终态补写「仍为 PENDING_APPROVAL」的执行记录；默认每 10 分钟。
# PLATFORM_APPROVAL_RECONCILIATION_ENABLED=true
# PLATFORM_APPROVAL_RECONCILIATION_CRON=0 */10 * * * *
# PLATFORM_APPROVAL_RECONCILIATION_LIMIT=200

# ── Week 25：知识库 Agent 3（包装 enterprise RAG）──────────────────────────────
# 平台不存知识库正文：检索走 enterprise 8081 的内部只读端点。
# PLATFORM_KNOWLEDGE_INTERNAL_TOKEN 必须与 enterprise 的 ENTERPRISE_INTERNAL_TOKEN 完全一致；
# 未配置时检索显式失败（502），不会静默返回「没有相关内容」。
# PLATFORM_KNOWLEDGE_ENABLED=true
# PLATFORM_KNOWLEDGE_BASE_URL=http://127.0.0.1:8081
# PLATFORM_KNOWLEDGE_INTERNAL_TOKEN=
# PLATFORM_KNOWLEDGE_TIMEOUT_MS=5000
# PLATFORM_KNOWLEDGE_DEFAULT_TOP_K=4
# PLATFORM_KNOWLEDGE_MAX_TOP_K=10
# PLATFORM_KNOWLEDGE_MAX_QUESTION_CHARS=4000

# ── Week 21：记忆向量化（与 enterprise 共用同一组变量名）──────────────────────
# 默认 hashing：离线确定性、无需密钥，适合单测与本地联调；
# 生产建议 openai（OpenAI 兼容 embeddings 端点），此时 base-url / api-key / model 都必填。
# 注意：换模型会让旧记忆向量不可比；Week 23 起用 embedding_model 标记来源，
# 由管理员调用 POST /api/v1/platform/memories/rebuild-embeddings 重建。
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 维度必须与所选模型一致（hashing 用它定桶数量；openai 以模型返回为准）
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30

