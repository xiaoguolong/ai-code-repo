# spring-ai-alibaba-agent 环境变量模板（第 8 周 Spring AI Alibaba Graph Agent，第 16 周起接入 PostgreSQL）
# 复制为 .env（同目录）后按需填写；真实 Key 与连接串切勿提交到仓库（.env 已被 .gitignore 忽略）。
#
# 怎么被读取（二选一，环境变量优先级高于 .env）：
#   IDEA  ：运行配置用 EnvFile 插件指向本文件复制出的 .env（$PROJECT_DIR$/apps/spring-ai-alibaba-agent/.env）
#   命令行：在模块目录下启动时由 spring.config.import 自动读取本目录 .env
#
# 数据库名/主机/账号各环境都不同，这里只给格式，填你们环境自己的值即可；
# 代码与文档不含任何具体库名，配什么就连什么。

# —— 模型（必填）——
# Spring AI 的 OpenAI 兼容端点：只写主机名，切勿带 /v1（Spring AI 自行拼接 /v1/chat/completions）。
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# —— ai-core 统一 LLM 参数（本模块 Graph 运行时常量；base-url 含 /v1）——
LLM_BASE_URL=https://api.deepseek.com/v1

# —— 可选：本机代理（仅 openai-compatible 适配器走 ai-core RestClient 时生效）——
LLM_PROXY_HOST=
LLM_PROXY_PORT=7890

# —— 可选：框架适配器 spring-ai（默认）| openai-compatible ——
FRAMEWORK_MODEL_PROVIDER=spring-ai

# —— 可选：Prompt 模板版本 ——
PROMPT_VERSION=v1

# —— 数据库（落库模式必填；各环境填自己的库）——
# 第 16 周起平台 RBAC / 执行记录 / 审计落 PostgreSQL，Flyway 在启动时自动迁移。
# 该库可以与其它应用共用：本模块使用专属历史表 flyway_schema_history_platform 隔离版本号。
# 注意：URL 里的库名与账号请替换为本环境实际值，不要照抄示例中的占位符。
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:<db-port>/<db-name>
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>
# Spring Boot 会自动把上面的 SPRING_DATASOURCE_* 绑定到 spring.datasource.*，无需额外变量。

# —— 可选：持久化模式（默认 jdbc 落库；memory = 进程内，无需数据库，用于快速演示）——
# PLATFORM_PERSISTENCE_MODE=jdbc

# —— 可选：密码哈希盐（生产必须覆盖，禁止用默认值）——
AUTH_PASSWORD_SALT=change-me-please

# —— 可选：Sa-Token 会话时长（秒）——
# SA_TOKEN_TIMEOUT=86400

# —— 可选：Redis（第 17 周可观测与后续缓存使用；本模块当前不依赖）——
REDIS_HOST=localhost
REDIS_PORT=6379
# ── 可选：Week 18 Langfuse（LLM Trace / Prompt 管理 / Token 与成本）──
# 默认全关（LANGFUSE_ENABLED 不设或 false 时零导出、零 langfuse.* 属性、Prompt 走 classpath）。
# host 是 Langfuse Web 根地址（端口 3000），OTLP 摄取端点由应用拼成 <host>/api/public/otel/v1/traces。
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://<langfuse-host>:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 仅用于拼 UI 深链（langfuse-status / trace-context 的 langfuseTraceUrl），不填则该字段为 null
LANGFUSE_PROJECT_ID=
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=
# 正文采集：默认关闭；置 true 时必须同时保证 guardrail.enabled=true（否则采集自动失效）
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_MAX_CONTENT_CHARS=2000
LANGFUSE_TIMEOUT_MS=10000
# Prompt 管理：与 LANGFUSE_ENABLED 相互独立，只需 host + 密钥
LANGFUSE_PROMPT_ENABLED=false
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60
# 模型价目表（USD / 百万 token）建议写在 application.yml 的 langfuse.model-prices 下（键含横线，环境变量不便表达）
# ── 可选：Week 17 通用 OTLP collector 导出（默认 true，导出到 http://localhost:4318/v1/traces）──
# 本地没起 collector 时置 false，可消除 SDK 的导出失败日志（只影响通用链路后端，不影响 Langfuse）。
OTEL_EXPORT_ENABLED=true
# 需要导出到真实 collector（Jaeger/Tempo/OTel Collector）时改端点；
# 生产按根地址写法：OTEL_EXPORTER_OTLP_ENDPOINT=http://<collector-host>:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
