<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.aicode</groupId>
    <artifactId>spring-ai-alibaba-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>spring-ai-alibaba-agent</name>
    <description>Week 8 Spring AI Alibaba Graph agent: framework adapters over domain ports, tool calling and MCP</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jdk.17.home>E:/Program Files/Eclipse Adoptium/jdk-17.0.20.8-hotspot</jdk.17.home>
        <spring-ai.version>1.0.0</spring-ai.version>
        <spring-ai-alibaba.version>1.0.0.2</spring-ai-alibaba.version>
        <sa-token.version>1.46.0</sa-token.version>
        <!-- SkyWalking Toolkit 在 Maven Central 的最新可发布版本为 9.7.0（10.x 只随发行包提供）。
             该 artifact 只声明静态方法签名，与 10.x Agent 的 apm-toolkit-activation 运行时兼容。 -->
        <skywalking.toolkit.version>9.7.0</skywalking.toolkit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.aicode</groupId>
            <artifactId>ai-core</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Week 16：平台 RBAC / 执行记录 / 审计落库（PostgreSQL + Flyway） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>
        <!-- Week 17：可观测（OpenTelemetry）。Micrometer 作为门面，bridge 落到 OTel SDK，避免领域层依赖 OTel 类型。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Micrometer Tracing 门面 + OTel 桥接：提供 io.micrometer.tracing.Tracer 与 W3C 传播器 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- OTLP/HTTP 导出（默认端点 http://localhost:4318/v1/traces）；collector 不可达时降级，不影响业务 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- 指标出口：GET /actuator/prometheus -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
          Week 19：SkyWalking 手动埋点 Toolkit。
          作用域 provided：只提供编译期符号（TraceContext / ActiveSpan / Tracer 的静态方法签名），
          运行期由 Java Agent 的 apm-toolkit-activation 提供实现。
          为什么仍需反射调用（见 ToolkitSpanBridge）：Agent 未挂载时这些类不在 classpath，
          直接引用会 NoClassDefFoundError；反射 + 降级可保证「没挂 Agent 也能正常启动」。
        -->
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-trace</artifactId>
            <version>${skywalking.toolkit.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 单测用 H2（MODE=PostgreSQL）跑同一套 Flyway 迁移，无需真实 PostgreSQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Week 17：SimpleTracer / SimpleMeterRegistry，断言 span 树与指标而不连真实 collector -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Week 17：InMemorySpanExporter，用真实 OTel SDK 断言 traceId / spanId / 父子关系 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>aliyun</id>
            <name>Aliyun Maven</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <fork>true</fork>
                    <executable>${jdk.17.home}/bin/javac</executable>
                    <compilerVersion>17</compilerVersion>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <jvm>${jdk.17.home}/bin/java</jvm>
                    <!-- Week 18 修复：surefire 默认只匹配 *Test.java，**静态嵌套测试类**（Outer$Inner.class）
                         不会被发现 —— 结果是 Week 17 的 ObservabilityDisabledTest 一次都没跑过。
                         这里显式把「外层类名以 Test 结尾的嵌套类」纳入匹配，避免测试静默不执行。 -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <!-- 嵌套测试类（Outer$Inner.class）：通配符里的 $ 会被当成正则锚点，必须用 %regex -->
                        <include>%regex[.*Test(\$.*)?]</include>
                    </includes>
                    <!-- surefire 默认 excludes 含 **/*$*（跳过内部类）；不显式覆盖的话上面的 include 等于白写。
                         这里只保留与测试无关的排除项，让静态嵌套测试类真正被执行。 -->
                    <excludes>
                        <exclude>**/package-info.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <executable>${jdk.17.home}/bin/java</executable>
                    <!-- Week 16：本地启动默认激活 jdbc profile，连接 PostgreSQL 并跑 Flyway 迁移 -->
                    <profiles>
                        <profile>jdbc</profile>
                    </profiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
