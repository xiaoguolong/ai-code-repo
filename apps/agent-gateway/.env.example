# Week 19 — agent-gateway 环境变量模板（入库，供新环境照抄）
#
# 用法（三选一，任选其一即可，进程环境变量优先级最高）：
#   1) IDEA：启用 EnvFile 插件指向**本模块** .env（运行配置里 envFilePaths = $PROJECT_DIR$/apps/agent-gateway/.env）；
#   2) IDEA（不装插件）：把 Run Configuration 的 Working directory 设为
#      $PROJECT_DIR$/apps/agent-gateway，application.yml 里的
#      `spring.config.import: optional:file:.env[.properties]` 就会读到本目录 .env；
#   3) 命令行：`cd apps/agent-gateway` 后 `mvn spring-boot:run`，或启动 jar 时显式 set 环境变量。
#
# .env（填了真实值）不入库，本文件（占位符）入库 —— 这是新环境能照着配自己的库的唯一途径。

# ── 平台服务地址（Feign 出口）──────────────────────────────────────────────────
# 网关不引注册中心，路由目标就是这一项。
GATEWAY_ROUTE_PLATFORM_URI=http://localhost:8084

# ── 会话与缓存（Redis）────────────────────────────────────────────────────────
# 会话键：gw:session:<平台 token>；目录缓存键：gw:catalog:agents:v1；幂等键：gw:idem:...
SPRING_REDIS_HOST=
SPRING_REDIS_PORT=6379
# 若 Redis 设了 requirepass 必须填，否则 Lettuce 在 HELLO 阶段报 NOAUTH（实测踩过）
SPRING_REDIS_PASSWORD=

# ── 网关自身参数（可选，均有默认值）──────────────────────────────────────────
# 对外会话头名（与平台 sa-token 的 token-name 保持一致）
GATEWAY_SESSION_TOKEN_NAME=Authorization
# 会话有效期（秒）
GATEWAY_TOKEN_TTL_SECONDS=1800
# Agent 目录缓存 TTL（秒）与缓存键前缀
GATEWAY_CATALOG_CACHE_TTL_SECONDS=30
GATEWAY_CATALOG_KEY_PREFIX=gw:catalog:agents
# 写入幂等键 TTL（秒）
GATEWAY_IDEMPOTENCY_TTL_SECONDS=300

# ── Week 19：SkyWalking Java Agent（可选）────────────────────────────────────
# 网关侧不写一行 SkyWalking 代码：HTTP / Redis / Feign / JVM 全靠 Agent 自动埋点。
# Agent 的开关在**启动参数**里（IDEA 写进 Run Configuration 的 VM options，不要放 Program arguments）：
#   -javaagent:E:\skywalking-agent\skywalking-agent.jar
#   -Dskywalking.agent.service_name=ai-code-gateway
#   -Dskywalking.agent.instance_name=gateway-1
#   -Dskywalking.collector.backend_service=<oap-host>:11800
# 不挂 Agent 时网关照常工作（/api/v1/gateway/status 的 skywalkingAgent 探针会如实回 false）。
SW_AGENT_NAME=ai-code-gateway
SW_AGENT_INSTANCE_NAME=gateway-1
