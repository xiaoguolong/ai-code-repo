# patient-agent 环境变量模板（第 6 周 Tool Calling）
# 复制为 .env（同目录）后按需填写；真实 Key 与连接串切勿提交到仓库（.env 已被 .gitignore 忽略）。
#
# 数据库名/主机/账号各环境都不同，这里只给格式，填你们环境自己的值即可。
# 注意：URL 里的库名与账号请替换为本环境实际值，不要照抄示例中的占位符。

# —— 模型（必填）——
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# —— 可选：本机代理（空则直连）——
LLM_PROXY_HOST=
LLM_PROXY_PORT=7890

# —— 可选：Prompt 模板版本 ——
PROMPT_VERSION=v1

# —— 数据库（本模块不落库，仅当复用 ai-core 落库能力时才需要；留空可整段删除）——
# SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:<db-port>/<db-name>
# SPRING_DATASOURCE_USERNAME=<db-user>
# SPRING_DATASOURCE_PASSWORD=<db-password>

# —— Redis（短期会话记忆用；memory = 进程内，多实例共享才需要 Redis）——
REDIS_HOST=localhost
REDIS_PORT=6379
# 也可使用 Spring 标准名，二者等价：
# SPRING_REDIS_HOST=localhost
# SPRING_REDIS_PORT=6379

# —— 可选：记忆提供方（memory 默认 | redis）——
# MEMORY_SHORT_TERM_PROVIDER=memory
# MEMORY_LONG_TERM_PROVIDER=memory
