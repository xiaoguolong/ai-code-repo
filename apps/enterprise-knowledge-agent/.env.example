# enterprise-knowledge-agent 环境变量模板（第 4 周）
# 复制为 .env（同目录）后按需填写；真实 Key 与连接串切勿提交到仓库（.env 已被 .gitignore 忽略）。
#
# 数据库名/主机/账号各环境都不同，这里只给格式，填你们环境自己的值即可。
# 注意：URL 里的库名与账号请替换为本环境实际值，不要照抄示例中的占位符。

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_PROXY_HOST=
LLM_PROXY_PORT=7890

# —— 数据库（必填；pgvector 扩展按需自行安装）——
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:<db-port>/<db-name>
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>

RAG_VECTOR_STORE=pgvector

EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=https://ws-7x0g7r1imgk8va7t.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

OCR_PROVIDER=qianfan
OCR_BASE_URL=https://qianfan.baidubce.com
OCR_API_KEY=
OCR_MODEL=paddleocr-vl-0.9b

AUTH_PASSWORD_SALT=change-me-please
FILE_STORAGE_DIR=./data/files
FILE_PUBLIC_BASE_URL=http://localhost:8081
