# enterprise-knowledge-agent 环境变量模板（第 4 周）
# 复制为 .env（同目录）后按需填写；真实 Key 与连接串切勿提交到仓库（.env 已被 .gitignore 忽略）。
#
# 数据库名/主机/账号各环境都不同，这里只给格式，填你们环境自己的值即可。
# 注意：URL 里的库名与账号请替换为本环境实际值，不要照抄示例中的占位符。

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_PROXY_HOST=
LLM_PROXY_PORT=7890

# —— 数据库（必填；pgvector 扩展按需自行安装）——
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:<db-port>/<db-name>
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>

RAG_VECTOR_STORE=pgvector

EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=https://ws-7x0g7r1imgk8va7t.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

OCR_PROVIDER=qianfan
OCR_BASE_URL=https://qianfan.baidubce.com
OCR_API_KEY=
OCR_MODEL=paddleocr-vl-0.9b

AUTH_PASSWORD_SALT=change-me-please
FILE_STORAGE_DIR=./data/files
FILE_PUBLIC_BASE_URL=http://localhost:8081

# —— Week 21 统一身份（SSO，可选）——
# 默认关闭：不配置就完全走本地账号（第 4 周行为）。
# 打开后，登录委托平台 8084 的 /api/v1/platform/auth/verify 校验；本地首次登录按 sso_user_link 自动开户。
SSO_ENABLED=false
SSO_PLATFORM_BASE_URL=http://localhost:8084
SSO_PLATFORM_TIMEOUT_MS=3000
SSO_AUTO_PROVISION=true

# —— Week 23 SSO 映射运维（可选，A1 运维令牌）——
# 只用于 GET/POST/DELETE /api/v1/admin/sso-links；未配置时端点一律 403（fail closed）。
# 生产用随机长字符串并定期轮换；不要写进仓库，也不要与平台密码/LLM Key 复用。
# ENTERPRISE_ADMIN_TOKEN=change-me-to-a-random-secret

# —— Week 25 平台内部只读接口（可选，内部令牌）——
# 只用于 GET /api/v1/internal/knowledge/bases 与 POST /api/v1/internal/knowledge/search；
# 必须与平台侧 PLATFORM_KNOWLEDGE_INTERNAL_TOKEN 完全相同；未配置时端点一律 403（fail closed）。
# 用途：平台“知识库 Agent”通过它做检索，答案由平台生成（进平台审计/观测）。
# ENTERPRISE_INTERNAL_TOKEN=change-me-to-a-random-secret

