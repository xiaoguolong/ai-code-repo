# ============================================================================
# Week 20 监控栈环境变量模板（复制为 .env 后填写；.env 已被 .gitignore 忽略）
# ============================================================================

# —— Grafana（必填）——
# 管理员密码：不要用 admin/admin，也不要提交到仓库
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# —— Prometheus 数据保留（可选）——
# 时间与体积双上限；超出任一即删除最旧数据块
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB

# —— 抓取目标说明（可选，改这里不会自动改 prometheus.yml）——
# 应用在本地时，需先在本机执行 tools\metrics-tunnel.ps1 建立反向隧道：
#   云端 127.0.0.1:18084 -> 本地 8084（平台）
#   云端 127.0.0.1:18080 -> 本地 8080（网关）
# 若将来应用上云，把 deploy/monitoring/prometheus/prometheus.yml 里的 targets
# 改成应用真实地址即可（两个 target 是静态配置，不用注册中心）。
