# Week 19 — SkyWalking 部署环境变量模板
#
# 用法：
#   cp .env.example .env    # 然后按本环境真实值填写
#   docker compose up -d
#
# 约定：本文件只放**占位符**，禁止填任何环境的真实口令/主机名（换环境会误导）。

# ── OAP 存储：复用本机既有 PostgreSQL 16 的独立库 skywalking ──────────────────
# 建库命令（只做一次；aidemo 用户无 CREATEDB 权限，故用超级用户 postgres）：
#   docker exec pg16 psql -U postgres -d postgres -c 'CREATE DATABASE skywalking OWNER aidemo'
SW_JDBC_URL=jdbc:postgresql://<postgres-host>:<postgres-port>/skywalking
SW_DATA_SOURCE_USER=<db-user>
SW_DATA_SOURCE_PASSWORD=<db-password>

# ── JVM 内存上限（必填建议：宿主内存 < 8G 时必须显式限制）──────────────────────
# OAP 默认只给 -Xms，无 -Xmx；容器里 JVM 会按宿主内存的 1/4 取上限。
# 本机（3.8 G）用 768M 堆 + 256M 初始；更大机器可放宽。
OAP_JAVA_OPTS=-Xms256M -Xmx768M
UI_JAVA_OPTS=-Xms64M -Xmx256M

# ── UI 端口（宿主）：默认 8088，避免与业务网关 8080 冲突 ──────────────────────
SW_UI_PORT=8088

# ── 应用侧（Agent）环境变量：写在应用启动环境里，不在本文件 ────────────────────
# 网关（8080）：
#   SKYWALKING_AGENT_PATH=/opt/skywalking-agent/skywalking-agent.jar
#   SW_AGENT_NAME=ai-code-gateway
#   SW_AGENT_COLLECTOR_BACKEND_SERVICES=<oap-host>:11800
#   SW_AGENT_INSTANCE_NAME=gateway-1
# 平台（8084）：
#   SW_AGENT_NAME=ai-code-platform
#   SW_AGENT_INSTANCE_NAME=platform-1
#   SKYWALKING_ENABLED=true            # 打开应用侧手动埋点（agent.run / llm.chat / tool.call）
#   SW_AGENT_NAME / SW_AGENT_COLLECTOR_BACKEND_SERVICES 同时用于 /observability/skywalking-status 自检展示
