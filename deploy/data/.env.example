# deploy/data/.env 模板（提交这份，真实 .env 不入库）
#
# 用法：cp .env.example .env && 生成强随机密码填入 && docker compose up -d
#
# 生成密码（任选其一）：
#   openssl rand -hex 16
#   pwsh -Command "[guid]::NewGuid().ToString('N')"
#
# ⚠️ 这两个密码会被业务应用和 SkyWalking 共用：
#   - 业务应用：SPRING_DATASOURCE_PASSWORD / SPRING_REDIS_PASSWORD
#   - SkyWalking：SW_DATA_SOURCE_PASSWORD
#   改密码时要同步改这三处，否则会连不上。

# 业务库与 SkyWalking 存储库共用一个实例（两个 database：aidemo / skywalking）
POSTGRES_USER=aidemo
POSTGRES_PASSWORD=
POSTGRES_DB=aidemo

# Redis（业务缓存/会话/记忆）
REDIS_PASSWORD=
