# Langfuse v4 自托管环境变量模板（Week 18）
#
# 用法：
#   cp .env.example .env
#   按下面注释生成并填入密钥（本文件入库，只放占位符；.env 不入库）
#   docker compose up -d
#
# 注意：LANGFUSE_INIT_* 的值**不要加引号**（官方已知问题 #3398）。

# ── 访问地址：必须是浏览器与应用能访问到的地址（不要写 localhost，除非本机访问） ──
NEXTAUTH_URL=http://<langfuse-host>:3000

# ── 必填密钥 ──
# NEXTAUTH_SECRET / ENCRYPTION_KEY / SALT 生成：openssl rand -hex 32
# 重要：SALT 与 ENCRYPTION_KEY 一旦投入使用**不得修改**，否则已加密的历史数据无法解密。
NEXTAUTH_SECRET=<openssl-rand-hex-32>
ENCRYPTION_KEY=<openssl-rand-hex-32>
SALT=<openssl-rand-hex-32>

# ── Postgres（Langfuse 元数据：用户/项目/评分等） ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=postgres
POSTGRES_VERSION=17
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── ClickHouse（追踪与观测明细） ──
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=<clickhouse-password>

# ── Redis（队列与缓存） ──
REDIS_AUTH=<redis-password>

# ── MinIO（事件与媒体对象存储） ──
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=<minio-password>

# ── Headless 初始化：首次启动自动创建组织 / 项目 / API Key / 初始用户 ──
# 资源依赖：可以先建组织再建项目与用户；不能只建项目不建组织。
# API Key 命名规则：public key 以 pk-lf- 开头，secret key 以 sk-lf- 开头。
# 下面两个 key 要与 8084 的 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY 保持一致。
LANGFUSE_INIT_ORG_ID=ai-code-repo
LANGFUSE_INIT_ORG_NAME=AI Code Repo
LANGFUSE_INIT_PROJECT_ID=ai-code-repo
LANGFUSE_INIT_PROJECT_NAME=AI Code Repo Platform
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<local-public-key>
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<local-secret-key>
LANGFUSE_INIT_USER_EMAIL=<admin-email>
LANGFUSE_INIT_USER_NAME=Platform Admin
LANGFUSE_INIT_USER_PASSWORD=<admin-password>

# ── 可选 ──
# 遥测上报（默认 true，可关）
TELEMETRY_ENABLED=true
# MinIO 对外地址（媒体上传，仅浏览器直传场景需要；不传媒体可忽略）
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT_EXTERNAL=http://<langfuse-host>:9090
